# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
TZ=UTC

# PostgreSQL. Use a dedicated, non-superuser role.
DATABASE_URL=postgresql://milk_app:change-me@127.0.0.1:5432/milk_tracker
# Separate database for tests. Its name must end with "_test".
TEST_DATABASE_URL=postgresql://milk_app:change-me@127.0.0.1:5432/milk_tracker_test

# Long random strings. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=replace-with-at-least-32-random-characters
KEY_PEPPER=replace-with-at-least-16-random-characters

# Development-only seed password for the permanent admin. Forced change on first login.
SEED_ADMIN_PASSWORD=12345678

# Set to true when serving over HTTPS (production). Defaults to true in production.
COOKIE_SECURE=false
